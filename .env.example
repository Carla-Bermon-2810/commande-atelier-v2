# Variables publiques (elles sont visibles par le navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle

# Variables strictement serveur : ne jamais les préfixer par NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_votre_cle
ADMIN_ACCESS_CODE=choisissez-un-code-admin-long-et-aleatoire
ACCESS_SESSION_SECRET=generez-une-chaine-aleatoire-d-au-moins-32-caracteres

# E-mails de commande (expéditeur validé dans Resend)
RESEND_API_KEY=re_votre_cle
ORDER_RECIPIENT=atelier@votre-domaine.fr
ORDER_SENDER=Commande Atelier <commandes@votre-domaine.fr>
